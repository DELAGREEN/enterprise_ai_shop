# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ai_shop:ai_shop_password@localhost/ai_shop

# Пул соединений SQLAlchemy.
#   DB_POOL_SIZE      — постоянных соединений в пуле (держатся всегда)
#   DB_MAX_OVERFLOW   — временных соединений сверх пула (создаются при нагрузке,
#                       закрываются после простоя)
#
# Максимальное количество одновременных соединений с БД:
#   DB_POOL_SIZE + DB_MAX_OVERFLOW
#
# Пример: 20 + 30 = до 50 соединений на один процесс uvicorn.
#   ⚠️ Если запускаете uvicorn с --workers N, умножайте на N:
#   N=4, pool_size=10, max_overflow=10 → до 80 соединений к PostgreSQL.
#
# Ориентиры:
#   - Малая нагрузка (< 20 одновременных):  pool_size=5,  max_overflow=10
#   - Средняя (< 100 одновременных):        pool_size=15, max_overflow=20
#   - Высокая (сотни одновременных):        pool_size=25, max_overflow=25
#
#   Максимально допустимое значение ограничено PostgreSQL:
#     SHOW max_connections;   -- по умолчанию 100 на весь сервер
#   Не ставьте DB_POOL_SIZE + DB_MAX_OVERFLOW больше, чем
#   (max_connections - зарезервировано для других сервисов) / количество воркеров.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# LDAP
LDAP_SERVER=localhost:389
