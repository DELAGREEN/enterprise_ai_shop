FROM langflowai/langflow:latest

# Устанавливаем пакеты в виртуальное окружение Langflow
RUN /app/.venv/bin/python -m pip install --no-cache-dir \
    pdfplumber \
    python-docx \
    camelot-py[cv] \
    openpyxl \
    tiktoken \
    fastembed \
    docling

# (опционально) можно скопировать requirements.txt
# COPY requirements.txt /app/requirements.txt
# RUN /app/.venv/bin/python -m pip install --no-cache-dir -r /app/requirements.txt